rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user has a specific role
    function hasRole(role) {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == role;
    }
    
    // Check if the user is an Admin
    function isAdmin() {
      return hasRole('admin') || hasRole('Admin');
    }

    // Dynamic Permission Check
    function checkPermission(module, action) {
      return isAdmin() || (
        isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && exists(/databases/$(database)/documents/settings/permissions)
        && get(/databases/$(database)/documents/settings/permissions).data
             .get(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role, {})
             .get(module, {})
             .get(action, false) == true
      );
    }

    // ── Settings (Dynamic Permissions) ────────────────────
    match /settings/permissions {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── User Profiles ─────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email == userId);
    }

    // ── Pending Users ─────────────────────────────────────
    match /pendingUsers/{userId} {
      allow create: if true;
      allow read: if isAuthenticated() && request.auth.token.email == userId;
      allow read, update, delete: if isAdmin();
    }

    // ── Leads (CRM) ──────────────────────────────────────
    match /leads/{leadId} {
      allow read: if checkPermission('leads', 'read');
      allow create: if checkPermission('leads', 'write') || (request.resource.data.source == 'Referral');
      allow update: if checkPermission('leads', 'write');
      allow delete: if isAdmin();
    }

    // ── Deals ────────────────────────────────────────────
    match /deals/{dealId} {
      allow read: if checkPermission('pipeline', 'read');
      allow create, update: if checkPermission('pipeline', 'write');
      allow delete: if isAdmin();
    }

    // ── Invoices ─────────────────────────────────────────
    match /invoices/{invoiceId} {
      // Invoices can be read if the role has full invoice access, OR if the invoice belongs to the user
      allow read: if checkPermission('invoices', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email) || (isAuthenticated() && resource.data.partnerId == request.auth.token.email);
      allow create, update: if checkPermission('invoices', 'write');
      allow delete: if isAdmin();
    }

    // ── Customers ────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if checkPermission('customers', 'read');
      allow create, update: if checkPermission('customers', 'write');
      allow delete: if isAdmin();
    }

    // ── Partners & Commission Ledgers ────────────────────
    match /partners/{partnerId} {
      allow read: if checkPermission('partners', 'read') || (isAuthenticated() && partnerId == request.auth.token.email);
      allow create, update: if checkPermission('partners', 'write');
      allow delete: if isAdmin();
    }

    // ── Fabrication / Projects ───────────────────────────
    match /projects/{projectId} {
      allow read: if checkPermission('projects', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email);
      allow create, update: if checkPermission('projects', 'write');
      allow delete: if isAdmin();
    }

    // ── Logistics ────────────────────────────────────────
    match /logistics/{logId} {
      allow read: if checkPermission('logistics', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email);
      allow create, update: if checkPermission('logistics', 'write');
      allow delete: if isAdmin();
    }

    // ── Pricing Config (Admin-only write) ────────────────
    match /pricing/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Messages ─────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if checkPermission('messages', 'read');
      allow create, update: if checkPermission('messages', 'write') || checkPermission('messages', 'read');
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.fromId == request.auth.token.email &&
        (request.time.toMillis() - resource.data.timestamp) < 900000
      );
    }

    // ── Typing Indicators ────────────────────────────────
    match /typing_indicators/{indicatorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && indicatorId == request.auth.token.email;
    }

    // ── Audit Log ────────────────────────────────────────
    match /auditLog/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Test Connection ──────────────────────────────────
    match /test/{docId} {
      allow read: if true;
    }

    // ── Catch-all: deny everything else ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
